{
  "name": "triage-agent",
  "description": "Reads a new ticket, sets severity from KB-107, and checks customer memory for context.",
  "definition": {
    "kind": "prompt",
    "rai_config": {
      "rai_policy_name": "${RAI_POLICY_ID}"
    },
    "model": "${TRIAGE_MODEL_DEPLOYMENT}",
    "reasoning": {
      "effort": "low"
    },
    "tools": [
      {
        "type": "mcp",
        "server_label": "ticket-system",
        "server_url": "${TICKET_SYSTEM_MCP_URL}",
        "allowed_tools": {
          "tool_names": [
            "get_ticket",
            "get_customer_memory",
            "update_ticket_status",
            "add_ticket_note"
          ]
        },
        "require_approval": "never",
        "project_connection_id": "ticket-system"
      },
      {
        "type": "mcp",
        "server_label": "support-kb",
        "server_url": "${KNOWLEDGE_BASE_MCP_URL}",
        "require_approval": "never",
        "project_connection_id": "support-kb"
      }
    ]
  }
}