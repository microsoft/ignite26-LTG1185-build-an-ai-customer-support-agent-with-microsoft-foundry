{
  "name": "diagnostics-agent",
  "description": "Analyzes attached logs with Code Interpreter, charts the error spike, and matches the error to a KB article.",
  "definition": {
    "kind": "prompt",
    "rai_config": {
      "rai_policy_name": "${RAI_POLICY_ID}"
    },
    "model": "${CHAT_MODEL_DEPLOYMENT}",
    "reasoning": {
      "effort": "low"
    },
    "tools": [
      {
        "type": "mcp",
        "server_label": "ticket-system",
        "server_url": "${TICKET_SYSTEM_MCP_URL}",
        "allowed_tools": {
          "tool_names": [
            "get_log_stats",
            "get_logs",
            "add_ticket_note"
          ]
        },
        "require_approval": "never",
        "project_connection_id": "ticket-system"
      },
      {
        "type": "mcp",
        "server_label": "support-kb",
        "server_url": "${KNOWLEDGE_BASE_MCP_URL}",
        "require_approval": "never",
        "project_connection_id": "support-kb"
      },
      {
        "type": "code_interpreter",
        "container": {
          "type": "auto"
        }
      }
    ]
  }
}